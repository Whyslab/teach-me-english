# teach-me-english — переменные окружения.
#
# Скопируй в .env и поправь под себя:
#     cp .env.example .env
#
# .env в git не попадает (см. .gitignore). Приложение читает эти переменные
# из окружения; deploy/install.sh подставляет их в systemd-юнит.

# Порт, на котором слушает сервер.
PORT=3000

# Файл базы данных. Относительный путь считается от каталога приложения,
# а не от того, откуда запущен процесс.
DATABASE_PATH=./vocab.db

# Кто имеет право обращаться к API из браузера, через запятую.
# Если открываешь приложение с телефона по адресу вида http://192.168.1.50:3000,
# этот адрес нужно добавить сюда — иначе браузер заблокирует запросы.
ALLOWED_ORIGINS=http://localhost:3000
