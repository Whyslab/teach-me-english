{
  "name": "teach-me-english",
  "version": "1.0.0",
  "description": "Offline-first PWA for learning English vocabulary with spaced repetition, backed by Express and SQLite.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "pwa",
    "spaced-repetition",
    "vocabulary",
    "sqlite",
    "express",
    "offline-first"
  ],
  "author": "WhySlab",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "sqlite3": "^5.1.7"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Whyslab/teach-me-english.git"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
