{
  "name": "teach-me-norwegian",
  "version": "1.0.0",
  "description": "Offline-first PWA for learning Norwegian (Bokmål) vocabulary with spaced repetition, backed by Express and SQLite.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.js"
  },
  "keywords": [
    "pwa",
    "spaced-repetition",
    "vocabulary",
    "norwegian",
    "bokmal",
    "norsk",
    "sqlite",
    "express",
    "offline-first"
  ],
  "author": "WhySlab",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Whyslab/teach-me-english.git"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
